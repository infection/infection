{
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "conflict": {
        "phpunit/phpunit": ">=12.4"
    },
    "autoload": {
        "psr-4": {
            "Infection\\E2ETests\\PreloadedSource\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Infection\\E2ETests\\PreloadedSource\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "ignore": {
                "CVE-2026-24765": "Testing PHPUnit 12.0 compatibility"
            }
        }
    }
}
