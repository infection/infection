{
    "$schema": "../../../resources/schema.json",
    "timeout": 25,
    "threads": 1,
    "source": {
        "directories": [
            "src"
        ]
    },
    "mutators": {
        "Plus": true
    },
    "logs": {
        "json": "var/infection/infection.json",
        "debugEvents": "var/infection/events.jsonl"
    },
    "tmpDir": "var/infection/tmp"
}
