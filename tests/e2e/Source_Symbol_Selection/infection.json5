{
    "$schema": "../../../resources/schema.json",
    "timeout": 25,
    "threads": 1,
    "source": {
        "directories": [
            "../../../src"
        ]
    },
    "logs": {
        "summary": "infection.log"
    },
    "phpUnit": {
        "configDir": "../../..",
        "customPath": "../../../vendor/bin/phpunit"
    },
    "mutators": {
        "NotIdentical": true,
        "PublicVisibility": true
    },
    "tmpDir": "infection"
}
