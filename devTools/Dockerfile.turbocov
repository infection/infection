ARG PHP_VERSION

FROM php:${PHP_VERSION}-cli-alpine

ARG TURBOCOV_VERSION

RUN apk add --update --no-cache \
		linux-headers \
	;

# turbocov cannot run alongside Xdebug or PCOV, so neither is installed here.
#
# turbocov is installed as a regular `turbocov` extension (not in the
# PCOV-impersonation mode). It is used through its PHPUnit 13.3+ coverage driver
# `ShipMonk\Turbocov\TurbocovDriver` from `shipmonk/turbocov-phpunit`.
# See https://github.com/shipmonk-rnd/turbocov
RUN --mount=type=bind,from=ghcr.io/php/pie:bin,source=/pie,target=/usr/local/bin/pie \
    set -eux; \
    apk add --no-cache --virtual .build-deps \
        ${PHPIZE_DEPS} \
        build-base \
        libzip-dev \
        libtool \
        oniguruma-dev \
        unzip \
        zlib-dev \
    ; \
    docker-php-ext-configure zip; \
    docker-php-ext-install -j$(nproc) \
        pcntl \
    ; \
    php -m | grep -qx mbstring || docker-php-ext-install -j$(nproc) mbstring; \
    pie install --no-cache shipmonk/turbocov:${TURBOCOV_VERSION}; \
    rm -rf /root/.pie; \
    runDeps="$( \
        scanelf --needed --nobanner --format '%n#p' --recursive /usr/local/lib/php/extensions \
            | tr ',' '\n' \
            | sort -u \
            | awk 'system("[ -e /usr/local/lib/" $1 " ]") == 0 { next } { print "so:" $1 }' \
    )"; \
    apk add --no-cache --virtual .app-phpexts-rundeps ${runDeps}; \
    apk del .build-deps; \
    php --ri turbocov; \
    if php -m | grep -qiE '^(pcov|xdebug)$'; then echo 'turbocov cannot run alongside PCOV or Xdebug' >&2; exit 1; fi

RUN apk add --no-cache \
        ncurses \
        make \
        bash \
        expect \
        git \
        zip

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY memory-limit.ini ${PHP_INI_DIR}/conf.d/

RUN adduser -h /opt/infection -s /bin/bash -D infection

USER infection

WORKDIR /opt/infection
